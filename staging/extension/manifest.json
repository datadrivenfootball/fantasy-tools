{
  "manifest_version": 3,
  "name": "DDF: Connect ESPN",
  "version": "0.1.0",
  "description": "Lets Data Driven Football read your ESPN fantasy leagues after you sign in at espn.com. Read-only. DDF never sees your ESPN password.",
  "key": "",
  "permissions": ["cookies"],
  "host_permissions": ["https://*.espn.com/*", "https://iskiybsimubiujwuchsl.supabase.co/*"],
  "background": { "service_worker": "background.js" },
  "externally_connectable": { "matches": ["https://datadrivenfootball.github.io/*", "http://localhost:8791/*"] },
  "action": { "default_title": "DDF: Connect ESPN", "default_popup": "popup.html" }
}
